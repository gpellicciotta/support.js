{
  "name": "@gpellicciotta/support.js",
  "version": "3.0.0-pre",
  "description": "General-purpose Javascript support code, both for client and server-side use",
  "type": "module",
  "exports": {
    "./*.mjs": "./src/*.mjs",
    "./*.css": "./css/*.css",
    "./css/*.css": "./css/*.css",
    "./package.json": "./package.json"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "release-notes": "node scripts/extract-release-notes.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpellicciotta/support.js.git"
  },
  "author": "Giovanni Pellicciotta",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gpellicciotta/support.js/issues"
  },
  "homepage": "https://github.com/gpellicciotta/support.js#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "vitest": "^5.0.5"
  }
}
