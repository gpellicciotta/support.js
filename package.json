{
  "name": "@gpellicciotta/support.js",
  "version": "2.0.1-pre",
  "description": "General-purpose Javascript support code, both for client and server-side use",
  "type": "module",
  "exports": {
    "./*.mjs": "./src/*.mjs",
    "./*.css": "./css/*.css",
    "./css/*.css": "./css/*.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "format": "prettier --write \"js/**/*.mjs\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"js/**/*.mjs\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\"",
    "release-notes": "node scripts/extract-release-notes.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpellicciotta/support.js.git"
  },
  "author": "Giovanni Pellicciotta",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gpellicciotta/support.js/issues"
  },
  "homepage": "https://github.com/gpellicciotta/support.js#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "vitest": "^5.0.5"
  }
}
